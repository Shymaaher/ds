    "    'flipper_width_4':  1200,\n",
    "}\n",
    "\n",
    "# Делим на 10 значения, которые превышают порог\n",
    "for col, threshold in Realistic.items():\n",
    "    if col in df.columns:\n",
    "        mask = df[col] > threshold\n",
    "        print(f\"{col}: исправлено {mask.sum()} значений\")\n",
    "        df.loc[mask, col] = df.loc[mask, col] / 10"
