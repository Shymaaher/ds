    "alphas = [0.01, 0.1, 1.0, 10.0]\n",
    "tuning_results = []\n",
    "\n",
    "for alpha in alphas:\n",
    "    lasso = Lasso(alpha=alpha)\n",
    "    lasso.fit(X_train_std, y_train)\n",
    "    y_pred = lasso.predict(X_valid_std)\n",
    "    metrics = get_metrics(y_valid, y_pred, f\"Lasso (std, alpha={alpha})\")\n",
    "    tuning_results.append(metrics)\n",
    "    \n",
    "    \n",
    "    ridge = Ridge(alpha=alpha)\n",
    "    ridge.fit(X_train_std, y_train)\n",
    "    y_pred = ridge.predict(X_valid_std)\n",
    "    metrics = get_metrics(y_valid, y_pred, f\"Ridge (std, alpha={alpha})\")\n",
    "    tuning_results.append(metrics)\n",
    "\n",
    "tuning_df = pd.DataFrame(tuning_results)\n",
    "tuning_df = tuning_df.sort_values(by='MAE').reset_index(drop=True)\n",
    "display(tuning_df.round(3))"
