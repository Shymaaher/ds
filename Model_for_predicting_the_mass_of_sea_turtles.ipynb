    "    'flipper_length_4': 445,\n",
    "    'flipper_width_4': 365,\n",
    "    'circle_count': 50\n",
    "}\n",
    "\n",
    "weight = predict_turtle_weight(example, best_model, scaler_std)\n",
    "print(f\"Предсказанная масса черепахи = {weight} кг\")"
