   ],
   "source": [
    "example = {\n",
    "    'shell_length': 900,\n",
    "    'shell_width': 720,\n",
    "    'head_length': 130,\n",
    "    'head_width': 115,\n",
    "    'flipper_length_1': 450,\n",
    "    'flipper_width_1': 360,\n",
    "    'flipper_length_2': 460,\n",
    "    'flipper_width_2': 370,\n",
    "    'flipper_length_3': 440,\n",
